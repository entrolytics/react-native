{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // rootDir keeps the emit flat, so it lands on the `types` path the manifest
    // declares (lib/typescript/index.d.ts) instead of lib/typescript/src/.
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "example", "**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
