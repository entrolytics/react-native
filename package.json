{
  "name": "@entrolytics/react-native",
  "version": "3.0.1",
  "description": "React Native SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "android",
    "entrolytics",
    "ios",
    "mobile",
    "react-native",
    "tracking"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/react-native/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/react-native",
    "directory": "packages/mobile/react-native"
  },
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "type": "module",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --react-plugin --type-aware --type-check --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write .",
    "prepack": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "latest",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "react": "*",
    "react-native": ">=0.85.3 <1.0.0"
  },
  "packageManager": "pnpm@12.23.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
